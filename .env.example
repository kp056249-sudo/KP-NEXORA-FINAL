# KP NEXORA local configuration
# FLASK_SECRET_KEY is optional: the app auto-generates a persistent local secret if blank.
FLASK_SECRET_KEY=

# Leave blank for local SQLite. Put a PostgreSQL URL here only when you actually have one.
DATABASE_URL=

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WEB_SEARCH=false

# Google OAuth — use the SAME Web application OAuth client for both login and Sheets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: instead of the two Google values above, place a downloaded Web application
# OAuth JSON beside app.py as google_client_secret.json or credentials.json.

# Branding: this is displayed publicly as the site owner/founder name.
KP_NEXORA_OWNER_NAME=Krishna Pandey
KP_NEXORA_OWNER_TITLE=Founder & Owner

# Optional owner photo shown on the profile/about pages.
KP_NEXORA_OWNER_PHOTO=/static/images/krishna-pandey.png

# Production public URL used by canonical URLs, robots.txt and sitemap.xml
KP_NEXORA_SITE_URL=https://your-domain.example
